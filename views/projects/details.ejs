<%- include('../partials/header') %>

<div class="container mt-5">
  <div class="row">
    <div class="col-md-8">
      <h2><%= project.projectName %></h2>
      
      <div class="card mb-4">
        <div class="card-header">
          <h5>Detail Proyek</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <p><strong>Customer:</strong> <%= project.customer.name %></p>
              <p><strong>Amount:</strong> Rp <%= project.amount.toLocaleString('id-ID') %></p>
              <p><strong>Project Date:</strong> <%= new Date(project.projectDate).toLocaleDateString('id-ID') %></p>
            </div>
            <div class="col-md-6">
              <p><strong>Status:</strong> <span class="badge bg-primary"><%= project.status %></span></p>
              <p><strong>Account Manager:</strong> <%= project.accountManager.username %></p>
            </div>
          </div>
          
          
          
          <a href="/projects/edit/<%= project.id %>" class="btn btn-warning">Edit Proyek</a>
          <a href="/projects/" class="btn btn-secondary">Kembali ke Daftar</a>
        </div>
      </div>

      <h3>Progress Comments</h3>
      
      <!-- List Comments -->
      <div class="comments-section mb-4">
        <% if (project.comments && project.comments.length > 0) { %>
          <% project.comments.forEach(c => { %>
            <div class="card mb-3">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <p class="mb-1"><strong><%= c.author.username %></strong></p>
                    <small class="text-muted"><%= new Date(c.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
                  </div>
                  <% if (user && (user.id === c.userId || user.role === 'admin')) { %>
                    <form method="POST" action="/projects/comment/delete/<%= c.id %>/<%= project.id %>" style="display:inline;" class="need-confirm" data-confirm="Yakin hapus komentar ini?">
                      <input type="hidden" name="_method" value="DELETE">
                      <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                    </form>
                  <% } %>
                </div>
                <p class="mt-2"><%= c.comment %></p>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="alert alert-info">Belum ada komentar progress untuk proyek ini</div>
        <% } %>
      </div>

      <!-- Add Comment Form -->
      <div class="card">
        <div class="card-header">
          <h5>Tambah Komentar Progress</h5>
        </div>
        <div class="card-body">
          <form method="POST" action="/projects/details/<%= project.id %>/comment">
            <div class="mb-3">
              <textarea name="comment" class="form-control" rows="4" placeholder="Masukkan komentar progress project..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Kirim Komentar</button>
            <!-- <a href="/projects" class="btn btn-secondary">Cancel</a> -->
          </form>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5>Info Cepat</h5>
        </div>
        <div class="card-body">
          <p><strong>Total Comments:</strong> <%= project.comments ? project.comments.length : 0 %></p>
          <p><strong>Created:</strong> <%= new Date(project.createdAt).toLocaleDateString('id-ID') %></p>
          <p><strong>Last Updated:</strong> <%= new Date(project.updatedAt).toLocaleDateString('id-ID') %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
