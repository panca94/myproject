    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery + Select2 for searchable dropdowns -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        // Initialize select2 on elements with class 'select2'
        $(document).ready(function() {
            if ($.fn.select2) {
                $('.select2').select2({ width: '100%' });
            }
        });
    </script>
        <!-- Confirmation modal for deletes -->
        <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm action</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p id="confirmModalMessage">Are you sure?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" id="confirmModalYes" class="btn btn-danger">Yes, delete</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            $(function() {
                let formToSubmit = null;
                const confirmModal = new bootstrap.Modal(document.getElementById('confirmModal'));

                // Intercept submit for forms with class 'need-confirm'
                $(document).on('submit', 'form.need-confirm', function(e) {
                    e.preventDefault();
                    formToSubmit = this;
                    const message = $(this).data('confirm') || 'Are you sure you want to continue?';
                    $('#confirmModalMessage').text(message);
                    confirmModal.show();
                });

                $('#confirmModalYes').on('click', function() {
                    if (formToSubmit) {
                        // unbind submit handler and submit
                        $(formToSubmit).off('submit');
                        formToSubmit.submit();
                    }
                });
            });
        </script>
</body>
</html>